{
  "name": "savant-docs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "preload-tweets": "node scripts/preload-tweets.mjs",
    "gen-blog": "node scripts/gen-blog.mjs",
    "predev": "node scripts/preload-tweets.mjs && node scripts/gen-blog.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/preload-tweets.mjs && node scripts/gen-blog.mjs",
    "build": "next build",
    "start": "next start",
    "serve": "serve out -l 3000",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "docker-build": "npm run preload-tweets && docker compose build",
    "docker-up": "npm run preload-tweets && docker compose up -d"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.7",
    "eslint-config-next": "^16.2.9",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.460.0",
    "next": "^16.2.9",
    "next-mdx-remote": "^5.0.0",
    "node-fetch": "^2.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-tweet": "^3.2.2",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "shiki": "^1.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "serve": "^14.2.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0"
  }
}
